<?xml version="1.0" encoding="utf-8"?>
<!-- Lo que cambia entre estilos (EstiloApp). El tema base (themes.xml) da los valores de la
     Compacta, que son EXACTAMENTE los que antes estaban escritos en cada layout; el overlay
     ThemeOverlay.FC.Tarjetas los redefine. Un layout que use uno de estos nunca debe llevar el
     valor a mano: si lo lleva, la Compacta y las Tarjetas se separan sin que nadie se entere. -->
<resources>
    <!-- Fondo detrás de las listas y del hilo (las tarjetas flotan sobre él). -->
    <attr name="fcFondoLista" format="reference|color" />
    <!-- Aire arriba y abajo dentro de las listas. -->
    <attr name="fcListaPaddingV" format="dimension" />
    <!-- Fila de lista pulsable (hilos, MPs): fondo y márgenes. -->
    <attr name="fcFilaFondo" format="reference" />
    <!-- Fila con su propio toque dentro (avisos): fondo sin onda. -->
    <attr name="fcFilaFondoQuieto" format="reference" />
    <!-- Color de relleno de una fila de aviso leída (la nueva usa fc_resaltado). -->
    <attr name="fcFilaColor" format="reference|color" />
    <attr name="fcFilaMargenH" format="dimension" />
    <attr name="fcFilaMargenV" format="dimension" />
    <!-- Recortar el contenido a la forma de la fila (esquinas redondeadas). -->
    <attr name="fcRecortarFila" format="boolean" />
    <!-- Alto de las rayas entre filas y entre mensajes (0 = sin raya). -->
    <attr name="fcDivisoriaAlto" format="dimension" />
    <!-- Aire encima de la raya de un mensaje: sin raya (Tarjetas) sería un hueco suelto. -->
    <attr name="fcDivisoriaMargen" format="dimension" />
    <!-- Relleno de la raíz de una fila de aviso: en Tarjetas, 1dp para que la fila (opaca) no
         tape el borde de la tarjeta. -->
    <attr name="fcFilaBorde" format="dimension" />
    <!-- Fondo de las citas dentro de un mensaje y del extracto de un aviso: en Tarjetas va sobre
         la tarjeta, no sobre el fondo, y en oscuro hace falta otro tono para distinguirse. -->
    <attr name="fcCitaFondo" format="reference|color" />
    <!-- Dónde va el cuadrito del sobre en filas de varias líneas. -->
    <attr name="fcSobreGravedad">
        <flag name="top" value="0x30" />
        <flag name="center_vertical" value="0x10" />
    </attr>
    <!-- Cuadrito del sobre en la lista de hilos. -->
    <attr name="fcSobreTamano" format="dimension" />
    <attr name="fcSobrePadding" format="dimension" />
    <attr name="fcSobreFondoNuevo" format="reference" />
    <attr name="fcSobreFondoLeido" format="reference" />
    <!-- Mensajes del hilo: fondos de los cuatro casos de PostAdapter.paintFrame y márgenes. -->
    <attr name="fcPostFondo" format="reference|color" />
    <attr name="fcPostResaltado" format="reference|color" />
    <attr name="fcPostOp" format="reference" />
    <attr name="fcPostOpResaltado" format="reference" />
    <attr name="fcPostMargenH" format="dimension" />
    <attr name="fcPostMargenV" format="dimension" />
    <attr name="fcPostOpMargenH" format="dimension" />
    <attr name="fcPostOpMargenV" format="dimension" />
    <attr name="fcPostPaddingV" format="dimension" />
    <!-- Grupos de Opciones (categorías y cada subpantalla): en Tarjetas, una tarjeta. -->
    <attr name="fcGrupoFondo" format="reference" />
    <attr name="fcGrupoPaddingH" format="dimension" />
    <attr name="fcGrupoPaddingV" format="dimension" />
    <!-- Estilo del TabLayout de subforos. -->
    <attr name="fcPestanas" format="reference" />
    <!-- Pastilla detrás del icono activo de la barra de abajo y su aire alrededor del icono. -->
    <attr name="fcNavPastilla" format="reference" />
    <attr name="fcNavPastillaPadH" format="dimension" />
    <attr name="fcNavPastillaPadV" format="dimension" />
    <!-- Fondo del número de la página actual en la barra de páginas del hilo. -->
    <attr name="fcPaginaActual" format="reference|color" />
</resources>
