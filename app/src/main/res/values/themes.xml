<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: el modo lo decide AppCompatDelegate según el ajuste de Opciones (ver
         TemaApp). El windowBackground es imprescindible: sin él, cualquier hueco entre paneles
         enseña el gris del sistema en vez del fondo de la app. -->
    <style name="Theme.FCForocoches" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fc_fondo</item>
        <item name="android:colorBackground">@color/fc_fondo</item>
        <item name="colorPrimary">@color/fc_rojo</item>
        <item name="colorAccent">@color/fc_rojo</item>
        <item name="android:textColorPrimary">@color/fc_texto</item>
        <item name="android:textColorSecondary">@color/fc_texto_2</item>
        <!-- Las barras del sistema se declaran EXPLICITAMENTE con el fondo de la app. Sin
             esto heredaban el color que le diera al tema de Material, que no tiene por que
             seguir nuestra paleta, y la barra de estado quedaba de un color ajeno pegado a la
             cabecera. El color de los iconos (reloj, bateria) NO se pone aqui: va en
             applyWindowInsets, que es lo unico que sabe si estamos en claro o en oscuro. -->
        <item name="android:statusBarColor">@color/fc_fondo</item>
        <item name="android:navigationBarColor">@color/fc_fondo</item>

        <!-- Estilo Compacta (EstiloApp): los valores de siempre. Ver attrs.xml. -->
        <item name="fcFondoLista">@android:color/transparent</item>
        <item name="fcListaPaddingV">0dp</item>
        <item name="fcFilaFondo">?attr/selectableItemBackground</item>
        <item name="fcFilaFondoQuieto">@null</item>
        <item name="fcFilaColor">@color/fc_fondo</item>
        <item name="fcFilaMargenH">0dp</item>
        <item name="fcFilaMargenV">0dp</item>
        <item name="fcRecortarFila">false</item>
        <item name="fcDivisoriaAlto">1dp</item>
        <item name="fcDivisoriaMargen">6dp</item>
        <item name="fcFilaBorde">0dp</item>
        <item name="fcCitaFondo">@color/fc_cita_fondo</item>
        <item name="fcSobreGravedad">center_vertical</item>
        <item name="fcSobreTamano">30dp</item>
        <item name="fcSobrePadding">3dp</item>
        <item name="fcSobreFondoNuevo">@null</item>
        <item name="fcSobreFondoLeido">@null</item>
        <item name="fcPostFondo">@android:color/transparent</item>
        <item name="fcPostResaltado">@color/fc_resaltado</item>
        <item name="fcPostOp">@drawable/bg_post_op</item>
        <item name="fcPostOpResaltado">@drawable/bg_post_op_highlight</item>
        <item name="fcPostMargenH">0dp</item>
        <item name="fcPostMargenV">0dp</item>
        <item name="fcPostOpMargenH">8dp</item>
        <item name="fcPostOpMargenV">4dp</item>
        <item name="fcPostPaddingV">6dp</item>
        <item name="fcPestanas">@style/FC.Pestanas</item>
        <item name="fcNavPastilla">@null</item>
        <item name="fcNavPastillaPadH">0dp</item>
        <item name="fcNavPastillaPadV">0dp</item>
        <item name="fcPaginaActual">@color/fc_rojo</item>
    </style>

    <!-- Pestañas de subforos de la Compacta: lo que antes estaba escrito en el TabLayout. -->
    <style name="FC.Pestanas" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/fc_rojo</item>
        <item name="tabSelectedTextColor">@color/fc_rojo</item>
        <item name="tabTextColor">@color/fc_texto_2</item>
    </style>

    <!-- Pestañas en pastilla (Tarjetas): el indicador ocupa toda la pestaña y es la pastilla
         roja; el fondo de cada una es la gris. Sin onda: sobre una pastilla se vería cuadrada. -->
    <style name="FC.Pestanas.Tarjetas">
        <item name="tabIndicator">@drawable/bg_pestana_indicador</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabSelectedTextColor">@color/fc_sobre_rojo</item>
        <item name="tabBackground">@drawable/bg_pestana</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabPaddingStart">18dp</item>
        <item name="tabPaddingEnd">18dp</item>
        <item name="tabContentStart">12dp</item>
        <item name="tabTextAppearance">@style/FC.Pestanas.Texto</item>
    </style>

    <!-- El texto de las pastillas, sin MAYÚSCULAS ni el espaciado de letras de los botones de
         Material (como en los mockups). -->
    <style name="FC.Pestanas.Texto" parent="TextAppearance.MaterialComponents.Button">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Estilo Tarjetas (EstiloApp): solo redefine atributos fc*. Se aplica en
         MainActivity.onCreate con theme.applyStyle(…, true) antes de setContentView. -->
    <style name="ThemeOverlay.FC.Tarjetas" parent="">
        <item name="fcFondoLista">@color/fc_fondo_tarjetas</item>
        <item name="fcListaPaddingV">7dp</item>
        <item name="fcFilaFondo">@drawable/bg_tarjeta_fila</item>
        <item name="fcFilaFondoQuieto">@drawable/bg_tarjeta</item>
        <item name="fcFilaColor">@color/fc_tarjeta</item>
        <item name="fcFilaMargenH">12dp</item>
        <item name="fcFilaMargenV">5dp</item>
        <item name="fcRecortarFila">true</item>
        <item name="fcDivisoriaAlto">0dp</item>
        <item name="fcDivisoriaMargen">0dp</item>
        <item name="fcFilaBorde">1dp</item>
        <item name="fcCitaFondo">@color/fc_cita_fondo_tarjeta</item>
        <item name="fcSobreGravedad">top</item>
        <item name="fcSobreTamano">40dp</item>
        <item name="fcSobrePadding">9dp</item>
        <item name="fcSobreFondoNuevo">@drawable/bg_sobre_nuevo</item>
        <item name="fcSobreFondoLeido">@drawable/bg_sobre_leido</item>
        <item name="fcPostFondo">@drawable/bg_tarjeta</item>
        <item name="fcPostResaltado">@drawable/bg_tarjeta_resaltada</item>
        <item name="fcPostOp">@drawable/bg_tarjeta_op</item>
        <item name="fcPostOpResaltado">@drawable/bg_tarjeta_op_resaltada</item>
        <item name="fcPostMargenH">12dp</item>
        <item name="fcPostMargenV">5dp</item>
        <item name="fcPostOpMargenH">12dp</item>
        <item name="fcPostOpMargenV">5dp</item>
        <item name="fcPostPaddingV">12dp</item>
        <item name="fcPestanas">@style/FC.Pestanas.Tarjetas</item>
        <item name="fcNavPastilla">@drawable/bg_nav_pastilla</item>
        <item name="fcNavPastillaPadH">14dp</item>
        <item name="fcNavPastillaPadV">2dp</item>
        <item name="fcPaginaActual">@drawable/bg_pagina_actual</item>
    </style>

    <!-- Estilos del panel de Opciones. -->
    <style name="OptSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/fc_rojo</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="OptChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/fc_texto_2</item>
        <item name="android:background">@color/fc_chip</item>
    </style>

    <style name="OptRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/fc_texto</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="OptAddBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:text">Añadir</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fc_rojo</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Botón de la barra de formato BBCode del editor (Bloque A). -->
    <!-- Fila que pliega una lista larga de Opciones (ignorados, palabras, subforos).
         Se pliega en vez de darle scroll propio: un cajon con scroll dentro del ScrollView
         del panel es la misma trampa de gestos que se descarto con las citas largas. -->
    <style name="OptToggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fc_rojo</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Raya entre grupos de la barra de formato (texto · insertar · emoticonos). -->
    <style name="FmtSeparador">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <!-- fc_texto_off y no fc_divisoria: la divisoria sobre el gris de la barra no se ve. -->
        <item name="android:background">@color/fc_texto_off</item>
    </style>

    <style name="FmtButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/fc_texto_2</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
