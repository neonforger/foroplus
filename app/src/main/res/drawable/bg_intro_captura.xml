<?xml version="1.0" encoding="utf-8"?>
<!-- Marco de las capturas de la introducción: esquinas redondas y un borde fino, para que una
     captura oscura no se funda con el fondo oscuro (ni una clara con el claro). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/fcSuperficie" />
    <stroke android:width="1dp" android:color="?attr/fcTarjetaBorde" />
    <corners android:radius="20dp" />
</shape>
