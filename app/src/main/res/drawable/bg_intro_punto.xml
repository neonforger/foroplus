<?xml version="1.0" encoding="utf-8"?>
<!-- Punto de progreso de la introducción: rojo y alargado el actual (activated), gris el resto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_rojo" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fcDivisoria" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
