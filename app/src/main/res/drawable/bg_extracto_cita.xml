<?xml version="1.0" encoding="utf-8"?>
<!-- El trozo citado dentro de la tarjeta del editor: la misma gramática que una cita en el
     hilo (fondo suave del tema y barra roja a la izquierda), redondeado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fcCitaFondo" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_cita_barra" />
        </shape>
    </item>
</layer-list>
