<?xml version="1.0" encoding="utf-8"?>
<!-- Campo del login sobre fondo BLANCO: se enciende en rojo de la app al tener el foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_fondo" />
            <stroke android:width="2dp" android:color="@color/fc_rojo" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fc_chip" />
            <stroke android:width="1dp" android:color="@color/fc_divisoria" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
