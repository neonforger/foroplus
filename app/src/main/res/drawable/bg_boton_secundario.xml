<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario (fase 3): pastilla contorneada en rojo (p. ej. "Cerrar sesión": una acción
     seria, pero no LA acción de la pantalla). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/fc_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/fc_rojo" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
