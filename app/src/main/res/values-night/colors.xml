<?xml version="1.0" encoding="utf-8"?>
<!-- Modo oscuro. MISMOS nombres que values/colors.xml: si aquí falta uno, Android usa el claro
     y ese elemento se queda blanco en medio de una pantalla negra sin que falle nada.

     Por defecto no es un negro puro: el #000 con texto blanco produce halos y cansa en pantallas
     OLED con texto largo, que es exactamente lo que es un hilo del foro. Quien lo prefiera puede
     elegir otro tono en Opciones → Apariencia (TonoOscuro, colores fc_tono_* al final). Las
     SUPERFICIES no se usan con @color sino con su atributo de tema (?attr/fcFondo…, attrs.xml):
     si no, no seguirían al tono. -->
<resources>

    <color name="fc_fondo">#121214</color>
    <color name="fc_superficie">#1C1C20</color>

    <color name="fc_texto">#ECECEE</color>
    <color name="fc_texto_2">#B4B4BA</color>
    <color name="fc_texto_3">#8A8A90</color>
    <color name="fc_texto_off">#55555C</color>
    <color name="fc_participado">#4FC3CF</color>
    <color name="fc_conectado">#3FBC42</color>
    <color name="fc_conectado_texto">#66D16A</color>

    <color name="fc_divisoria">#2E2E34</color>
    <color name="fc_chip">#2A2A30</color>

    <!-- El rojo de marca aclarado. El #C8102E original sobre este fondo se queda por debajo de
         un contraste legible; este mantiene la identidad y se lee. -->
    <color name="fc_rojo">#FF6070</color>
    <!-- Tinta oscura sobre el rojo claro: 6,3:1 (el blanco daba 2,9:1). Ver values/colors. -->
    <color name="fc_sobre_rojo">#121214</color>

    <!-- La cita en oscuro: el rojo aclarado y un fondo un punto por encima del de la app,
         suficiente para delimitar la cita sin convertirla en un bloque que grita. -->
    <color name="fc_cita_barra">#FF6070</color>
    <color name="fc_cita_fondo">#232329</color>

    <!-- El resaltado del mensaje publicado, en versión oscura: el #FFF3F4 claro sobre fondo
         negro sería un fogonazo blanco. -->
    <color name="fc_resaltado">#3A2126</color>

    <!-- La lupa: los mismos amarillo y naranja, apagados para que el texto claro se lea encima. -->
    <color name="fc_busca">#5A4B00</color>
    <color name="fc_busca_actual">#A65400</color>

    <color name="fc_aviso_linea">#55323C</color>

    <color name="fc_error_fondo">#3A1F1D</color>
    <color name="fc_error_linea">#7A3A34</color>
    <color name="fc_borde_autor">#80FF6070</color>
    <color name="fc_scroll_pulgar">#99B4B4BA</color>

    <color name="fc_ripple">#33FFFFFF</color>

    <!-- Igual que en claro a proposito: es el avatar de relleno del foro (ver values/colors). -->
    <!-- Igual que en claro a propósito: va sobre el vídeo (ver values/colors). -->
    <!-- Velo detrás del panel del avatar: oscurece la pantalla para que el panel se lea como
         una capa encima. En oscuro va más denso, o sobre fondo negro ni se notaría. -->
    <color name="fc_velo">#99000000</color>

    <color name="fc_capa_boton">#99000000</color>
    <!-- Texto o icono ENCIMA de un vídeo o de fc_capa_boton (el ✕ del reproductor flotante).
         Blanco en los dos modos a propósito: no es fc_sobre_rojo, que en oscuro es tinta oscura. -->
    <color name="fc_sobre_capa">#FFFFFF</color>

    <color name="fc_avatar_fondo">#3FAFBC</color>
    <color name="fc_avatar_figura">#FFFFFF</color>

    <!-- Estilo Tarjetas (EstiloApp). Valores sacados de los mockups del 2026-10-09. -->
    <!-- Fondo gris cálido detrás de las tarjetas. -->
    <color name="fc_fondo_tarjetas">#121214</color>
    <!-- La tarjeta y su borde. -->
    <color name="fc_tarjeta">#1E1E23</color>
    <color name="fc_tarjeta_borde">#2E2E34</color>
    <!-- Fondo de las citas en Tarjetas: van sobre la tarjeta, no sobre el fondo. -->
    <color name="fc_cita_fondo_tarjeta">#2A2A30</color>
    <!-- Rojo suave: cuadrito del sobre sin leer y pastilla del icono activo. -->
    <color name="fc_rojo_suave">#3A2126</color>
    <!-- Nota privada: un pelín más de cuerpo en oscuro para que se vea. -->
    <color name="fc_nota_fondo">#33E0A020</color>


    <!-- Tono del modo oscuro (TonoOscuro). El de por defecto, "gris oscuro", son los fc_* de
         arriba. "Oscuro" es un paso hacia el negro y "Negro" es el negro puro de las pantallas
         AMOLED. En cada tono las superficies van un punto por encima del fondo (fondo < tarjeta <
         cita/chip < raya) para que tarjetas, citas y divisorias se sigan distinguiendo; los
         textos y el rojo no cambian (ContrasteTest los valida sobre los tres). -->
    <color name="fc_tono_oscuro_fondo">#0A0A0B</color>
    <color name="fc_tono_oscuro_superficie">#151518</color>
    <color name="fc_tono_oscuro_divisoria">#26262B</color>
    <color name="fc_tono_oscuro_chip">#222227</color>
    <color name="fc_tono_oscuro_cita_fondo">#1B1B20</color>
    <color name="fc_tono_oscuro_fondo_tarjetas">#0A0A0B</color>
    <color name="fc_tono_oscuro_tarjeta">#161619</color>
    <color name="fc_tono_oscuro_tarjeta_borde">#26262B</color>
    <color name="fc_tono_oscuro_cita_fondo_tarjeta">#222227</color>
    <color name="fc_tono_negro_fondo">#000000</color>
    <color name="fc_tono_negro_superficie">#121214</color>
    <color name="fc_tono_negro_divisoria">#222226</color>
    <color name="fc_tono_negro_chip">#1C1C20</color>
    <color name="fc_tono_negro_cita_fondo">#16161A</color>
    <color name="fc_tono_negro_fondo_tarjetas">#000000</color>
    <color name="fc_tono_negro_tarjeta">#0F0F11</color>
    <color name="fc_tono_negro_tarjeta_borde">#222226</color>
    <color name="fc_tono_negro_cita_fondo_tarjeta">#1C1C20</color>

</resources>
