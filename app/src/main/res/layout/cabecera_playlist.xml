<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de la pantalla de una playlist de Música: va DENTRO de la lista (la primera fila de
     PlaylistAdapter), para que al bajar deje sitio a las canciones. Con el reproductor fijo arriba
     (16:9) y una cabecera también fija, la lista se quedaba en tres filas y media en el Samsung. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <!-- Volver a la portada: el atrás del sistema hace lo mismo, esto es para quien no lo busca. -->
    <TextView
        android:id="@+id/pl_volver"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="-8dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/ic_atras"
        android:drawableTint="@color/fc_texto_2"
        android:text="Tus playlists"
        android:textSize="13sp"
        android:textColor="@color/fc_texto_2"
        android:background="?attr/selectableItemBackground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pl_nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/fc_texto" />

        <ImageView
            android:id="@+id/pl_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Renombrar o borrar la playlist" />
    </LinearLayout>

    <TextView
        android:id="@+id/pl_resumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/fc_texto_2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pl_reproducir"
            style="@style/BotonPrimario"
            android:layout_width="wrap_content"
            android:paddingStart="18dp"
            android:drawableStart="@drawable/ic_reproducir"
            android:drawablePadding="6dp"
            android:drawableTint="@color/fc_sobre_rojo"
            android:text="Reproducir" />

        <!-- Compartir la playlist como texto: lo enciende y le da su acción A12. -->
        <TextView
            android:id="@+id/pl_compartir"
            style="@style/BotonSecundario"
            android:layout_width="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Compartir"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Regla del spec: nada suena con la app en segundo plano, y una línea lo dice. -->
    <TextView
        android:id="@+id/pl_aviso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="La música se para al salir de la app"
        android:textSize="12.5sp"
        android:textColor="@color/fc_texto_2" />

    <TextView
        android:id="@+id/pl_vacia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingEnd="12dp"
        android:text="Esta playlist aún no tiene canciones. Vuelve a Tus playlists y toca + para añadirlas."
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/fc_texto_2"
        android:visibility="gone" />
</LinearLayout>
