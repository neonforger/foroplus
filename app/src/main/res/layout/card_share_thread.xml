<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un HILO. Es distinta de card_share_post a propósito: la identidad de un hilo
     es su TÍTULO, no su primer mensaje. Copiando la de mensaje, un hilo que abre con tres
     párrafos daba una imagen de tres pantallas con lo importante en letra pequeña arriba.
     Aquí el título manda y el mensaje es un extracto acotado. Ver TarjetaCompartir.crearHilo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="40dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/card_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/card_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- El extracto. maxLines es lo que impide el póster: un hilo puede abrir con una frase
         o con veinte párrafos, y la tarjeta tiene que aguantar los dos extremos. -->
    <TextView
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:lineSpacingExtra="4dp"
        android:maxLines="12"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/card_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxHeight="560dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/card_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="13sp"
        android:textColor="#C8102E"
        android:text="forocoches.com · vía ForoPlus" />

</LinearLayout>
