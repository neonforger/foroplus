<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla de la tarjeta que se comparte. NO se usa en ninguna pantalla: se infla fuera de
     la vista, se rellena y se dibuja sobre un lienzo (ver TarjetaCompartir). Por eso lleva
     medidas generosas: se renderiza a 1080 px de ancho, no al tamaño del móvil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="40dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/card_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null" />

        <!-- Nombre arriba y fecha debajo (como Reddit o X): compartiendo la línea, una fecha
             larga como "12-may-2026 23:53" se comía el nombre y salía "@Tommy DeV…". -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/card_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="17sp"
        android:textColor="#1A1A1A"
        android:lineSpacingExtra="4dp" />

    <!-- Primera foto del mensaje, si la hay. Con tope de alto: un post con nueve fotos daría
         una tarjeta absurda, y una foto vertical muy larga también. -->
    <ImageView
        android:id="@+id/card_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxHeight="620dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/card_thread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textSize="14sp"
        android:textColor="#616161"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/card_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:textColor="#C8102E"
        android:text="forocoches.com · vía ForoPlus" />

</LinearLayout>
