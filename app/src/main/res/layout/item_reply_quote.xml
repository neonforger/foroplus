<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de cita dentro del panel de respuesta: autor + extracto + ✕ para quitarla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:background="@color/fc_chip"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="@color/fc_rojo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quote_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/fc_rojo" />

        <TextView
            android:id="@+id/quote_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/fc_texto_2"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/quote_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="✕"
        android:textSize="15sp"
        android:textColor="@color/fc_texto_3"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Quitar cita" />

</LinearLayout>
