<?xml version="1.0" encoding="utf-8"?>
<!-- Verificarse en Música con la cuenta de FC (HojaVerificarMusica). Antes de tocar nada dice qué
     se envía, qué no, y que el coche del perfil cambia unos segundos y vuelve solo (spec). Fondo y
     esquinas salen del tema de las hojas. El botón queda fuera del scroll, siempre a la vista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <View style="@style/Asa" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verifícate con tu cuenta de ForoCoches"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/fc_texto" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/verificar_para"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para compartir canciones y dar corazones en Música."
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fc_texto_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="QUÉ SE ENVÍA"
                android:contentDescription="Qué se envía"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/fc_texto_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tu número de usuario de ForoCoches (tu nombre lo lee el servidor de tu ficha pública), tus votos, tus propuestas y las playlists que publiques."
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fc_texto" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="QUÉ NO"
                android:contentDescription="Qué no se envía"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/fc_texto_2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ni tu contraseña, ni tu sesión, ni nada del foro."
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fc_texto" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Para comprobar que la cuenta es tuya, tu coche del perfil cambiará unos segundos y volverá solo."
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fc_texto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Progreso y resultado. -->
    <LinearLayout
        android:id="@+id/verificar_progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/fc_rojo" />

        <TextView
            android:id="@+id/verificar_progreso_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="13.5sp"
            android:textColor="@color/fc_texto_2" />
    </LinearLayout>

    <TextView
        android:id="@+id/verificar_resultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fc_texto"
        android:visibility="gone" />

    <TextView
        android:id="@+id/verificar_boton"
        style="@style/BotonPrimario"
        android:layout_width="match_parent"
        android:layout_marginTop="14dp"
        android:text="Verificarme" />
</LinearLayout>
