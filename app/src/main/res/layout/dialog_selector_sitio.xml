<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de sitio (se abre tocando el título de la lista). Pantalla completa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sel_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fc_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/sel_cerrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:src="@drawable/ic_atras"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar el selector"
            android:focusable="true"
            android:clickable="true" />

        <EditText
            android:id="@+id/sel_buscar"
            style="@style/Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:hint="Buscar subforo"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:importantForAutofill="no" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/sel_lista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/sel_vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Ningún subforo coincide"
        android:textColor="@color/fc_texto_2"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
