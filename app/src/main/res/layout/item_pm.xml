<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la bandeja de MPs. Colores de la paleta (tema DayNight): sin ellos el texto sería
     invisible en modo oscuro. Fondo y márgenes salen del TEMA (atributos fc*, ver EstiloApp):
     la Compacta da los de siempre y Tarjetas la convierte en tarjeta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="?attr/fcFilaMargenH"
    android:layout_marginEnd="?attr/fcFilaMargenH"
    android:layout_marginTop="?attr/fcFilaMargenV"
    android:layout_marginBottom="?attr/fcFilaMargenV"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/fcFilaFondo"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <View
        android:id="@+id/pm_unread_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/dot_unread"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pm_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fc_texto"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pm_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:textColor="@color/fc_texto_3"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
