<?xml version="1.0" encoding="utf-8"?>
<!-- Espaciado APRETADO a propósito (2026-08-14): el coste fijo de cada post era de unos
     110dp antes de escribir una letra, y con 30 posts por página eso son diez pantallas de
     puro andamiaje. Se recorta solo el aire vertical; el texto, el avatar y las zonas de
     toque se quedan igual.

     El aire vertical y la raya salen del TEMA (atributos fc*, ver EstiloApp): Compacta 6dp y
     raya; Tarjetas 12dp y sin raya. El fondo y los márgenes los pone PostAdapter.paintFrame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="?attr/fcPostPaddingV"
    android:paddingBottom="?attr/fcPostPaddingV">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- El avatar y, encima, el punto de "conectado ahora" en la misma esquina que FC. -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/post_avatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="@null" />

            <View
                android:id="@+id/post_conectado"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_punto_conectado"
                android:contentDescription="Conectado ahora"
                android:visibility="gone" />
        </FrameLayout>

        <!-- El nombre y, si es quien abrió el hilo, la insignia "Autor" pegada a él (fase 2:
             el borde rojo solo no basta, no se puede depender de un color). El nombre va en el
             color del texto: lo rojo son las acciones. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/post_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="190dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/fc_texto"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/post_autor_insignia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="Autor"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/fc_rojo"
                android:background="@drawable/bg_insignia_autor"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/post_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/fc_texto_3" />

        <!-- 48dp: la zona de toque recomendada (antes era un "⋮" de texto de ~30dp). El
             margen negativo lo alinea con el borde del texto sin comerse el hueco. -->
        <ImageButton
            android:id="@+id/post_menu"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-10dp"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones del mensaje"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="14sp"
        android:textColor="@color/fc_texto"
        android:lineSpacingExtra="2dp"
        android:textColorLink="@color/fc_rojo" />

    <!-- Embeds interactivos (X/IG/TikTok/YouTube/vídeo): cada uno es una tarjeta que al
         tocar carga el reproductor oficial en un WebView y reproduce inline. -->
    <LinearLayout
        android:id="@+id/post_embeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="2dp">

        <!-- Botones con icono Y texto, de 48dp de alto (fase 2). Abajo a la derecha, donde
             cae el pulgar; Citar, la acción principal, el último. El aspecto de Multicita lo
             pone BotonMulticita según esté marcada o no. -->
        <TextView
            android:id="@+id/post_multiquote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:drawableStart="@drawable/ic_multicita"
            android:drawablePadding="6dp"
            android:text="Multicita"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fc_texto_2"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/post_quote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-6dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:drawableStart="@drawable/ic_citar"
            android:drawablePadding="6dp"
            android:drawableTint="@color/fc_rojo"
            android:text="Citar"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fc_rojo"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Se oculta en los mensajes del autor del hilo: ahí delimita el recuadro rojo y esta
         raya lo cruzaría por debajo. -->
    <View
        android:id="@+id/post_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/fcDivisoriaAlto"
        android:layout_marginTop="?attr/fcDivisoriaMargen"
        android:background="@color/fc_divisoria" />

</LinearLayout>
