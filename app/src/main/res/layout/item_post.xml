<?xml version="1.0" encoding="utf-8"?>
<!-- Espaciado APRETADO a propósito (2026-08-14): el coste fijo de cada post era de unos
     110dp antes de escribir una letra, y con 30 posts por página eso son diez pantallas de
     puro andamiaje. Se recorta solo el aire vertical; el texto, el avatar y las zonas de
     toque se quedan igual.

     El aire vertical y la raya salen del TEMA (atributos fc*, ver EstiloApp): Compacta 6dp y
     raya; Tarjetas 12dp y sin raya. El fondo y los márgenes los pone PostAdapter.paintFrame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="?attr/fcPostPaddingV"
    android:paddingBottom="?attr/fcPostPaddingV">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- El avatar y, encima, el punto de "conectado ahora" en la misma esquina que FC. -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/post_avatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="@null" />

            <View
                android:id="@+id/post_conectado"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_punto_conectado"
                android:contentDescription="Conectado ahora"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/post_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/fc_rojo"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/post_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/fc_texto_3" />

        <TextView
            android:id="@+id/post_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="⋮"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/fc_texto_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones del mensaje"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="14sp"
        android:textColor="@color/fc_texto"
        android:lineSpacingExtra="2dp"
        android:textColorLink="@color/fc_rojo" />

    <!-- Embeds interactivos (X/IG/TikTok/YouTube/vídeo): cada uno es una tarjeta que al
         tocar carga el reproductor oficial en un WebView y reproduce inline. -->
    <LinearLayout
        android:id="@+id/post_embeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/post_multiquote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="＋"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/fc_texto_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Añadir a multicita" />

        <TextView
            android:id="@+id/post_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Citar"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/fc_rojo"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Se oculta en los mensajes del autor del hilo: ahí delimita el recuadro rojo y esta
         raya lo cruzaría por debajo. -->
    <View
        android:id="@+id/post_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/fcDivisoriaAlto"
        android:layout_marginTop="?attr/fcDivisoriaMargen"
        android:background="@color/fc_divisoria" />

</LinearLayout>
