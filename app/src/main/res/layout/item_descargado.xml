<?xml version="1.0" encoding="utf-8"?>
<!-- Una copia guardada en la lista de Descargados. El tamaño sale en cada fila y no solo en el
     total: si alguien tiene que hacer sitio, necesita saber CUÁL borrar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginStart="?attr/fcFilaMargenH"
    android:layout_marginEnd="?attr/fcFilaMargenH"
    android:layout_marginTop="?attr/fcFilaMargenV"
    android:layout_marginBottom="?attr/fcFilaMargenV"
    android:background="?attr/fcFilaFondoQuieto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:id="@+id/desc_fila"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/desc_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/fc_texto"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/desc_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textSize="12sp"
                android:textColor="@color/fc_texto_2" />

            <TextView
                android:id="@+id/desc_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="@color/fc_texto_3" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/desc_borrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_borrar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Borrar este hilo descargado" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/fcDivisoriaAlto"
        android:background="@color/fc_divisoria" />
</LinearLayout>
