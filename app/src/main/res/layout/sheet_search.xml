<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador. OJO con los colores fijos del EditText: el tema es DayNight y el panel tiene
     fondo blanco, así que sin textColor/textColorHint explícitos el campo es invisible en
     modo oscuro (mismo patrón que login_user y sheet_thread_pages). -->
<!-- Desplazable desde que tiene campo de usuario: con el teclado abierto y las sugerencias
     de nombres, el contenido no cabe y el botón de buscar quedaba tapado (medido en el
     Samsung el 2026-10-07). El relleno del teclado se le pone a esta vista (showSearchSheet). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <View style="@style/Asa" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/fc_rojo"
        android:letterSpacing="0.03"
        android:text="BUSCAR EN FOROCOCHES" />

    <EditText
        android:id="@+id/search_input"
        style="@style/Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:textSize="16sp"
        android:hint="Palabras a buscar"
        android:textColor="@color/fc_texto"
        android:textColorHint="@color/fc_texto_3"
        android:importantForAutofill="no" />

    <!-- Últimas búsquedas (Green Floyd, Márquez). Va justo DEBAJO del campo: es un atajo para
         no reescribir, así que tiene que estar donde ya estás mirando. Se esconde entero
         cuando no hay ninguna, para no dejar un hueco muerto la primera vez. -->
    <LinearLayout
        android:id="@+id/search_recientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- Buscar por usuario, como el campo "Buscar por nombre de usuario" de FC. Opcional: con
         palabras, las busca solo en lo suyo; sin palabras, enseña todo lo suyo (lo de su ficha). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_campo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:textSize="16sp"
            android:textColor="@color/fc_texto_3"
            android:text="\@" />

        <EditText
            android:id="@+id/search_user"
            android:background="@null"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="16sp"
            android:hint="Usuario (opcional)"
            android:textColor="@color/fc_texto"
            android:textColorHint="@color/fc_texto_3"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/search_user_clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/fc_texto_3"
            android:text="✕"
            android:contentDescription="Quitar el usuario"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Nombres que propone el foro al escribir (a partir de 3 letras). Como mucho cinco: el
         panel no se desplaza y con el teclado abierto no puede tapar el botón de buscar. -->
    <LinearLayout
        android:id="@+id/search_sugerencias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

<!-- Antes era un interruptor "Buscar solo en los títulos". El problema no era la etiqueta,
         era que apagarlo buscaba dentro de los mensajes y seguía devolviendo HILOS. Ahora son
         dos búsquedas distintas y cada una dice lo que te va a dar, porque lo que cambia no es
         dónde busca: es QUÉ te devuelve. -->
    <RadioGroup
        android:id="@+id/search_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/search_scope_titles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Títulos de los hilos"
            android:textSize="15sp"
            android:textColor="@color/fc_texto" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/search_scope_posts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Texto de los mensajes"
            android:textSize="15sp"
            android:textColor="@color/fc_texto" />
    </RadioGroup>

    <TextView
        android:id="@+id/search_ayuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/fc_texto_3"
        android:text="Por títulos salen hilos; por mensajes salen los mensajes, del más reciente al más antiguo." />

    <TextView
        android:id="@+id/search_go"
        style="@style/BotonPrimario"
        android:layout_height="48dp"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:text="Buscar" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
