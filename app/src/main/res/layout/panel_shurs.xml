<?xml version="1.0" encoding="utf-8"?>
<!-- Playlists de los shurs (C4): las playlists que la gente publica con su nombre de FC. Va
     incluido en panel_musica.xml DESPUÉS del botón "+", con fondo opaco: tapa la portada entera
     (también el botón). Dos pantallas: la lista (recientes / más guardadas, paginada) y el
     detalle de una playlist ajena (solo lectura, reproducible). Lo llena PanelShurs. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musica_shurs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fcFondoLista"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- La lista -->
    <LinearLayout
        android:id="@+id/shurs_lista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/shurs_volver"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="-8dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_atras"
                app:drawableTint="@color/fc_texto_2"
                android:text="Música"
                android:textSize="13sp"
                android:textColor="@color/fc_texto_2"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Playlists de los shurs"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/fc_texto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shurs_recientes"
                    style="@style/BotonPrimario"
                    android:layout_width="wrap_content"
                    android:text="Recientes" />

                <TextView
                    android:id="@+id/shurs_guardadas"
                    style="@style/BotonSecundario"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Más guardadas" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="?attr/fcListaPaddingV"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/shurs_filas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Vacío, cargando o error (se toca para reintentar). -->
                <TextView
                    android:id="@+id/shurs_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/fc_texto_2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/shurs_mas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Cargar más"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/fc_rojo"
                    android:drawableEnd="@drawable/ic_fila"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- El detalle de una playlist ajena: el reproductor fijo arriba (YouTube >= 200 dp y visible
         mientras suena) y el resto en un scroll. -->
    <LinearLayout
        android:id="@+id/shurs_detalle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/fcFondoLista"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/shurs_reproductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/shurs_det_volver"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="-8dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_atras"
                        app:drawableTint="@color/fc_texto_2"
                        android:text="Playlists de los shurs"
                        android:textSize="13sp"
                        android:textColor="@color/fc_texto_2"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/shurs_det_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/fc_texto" />

                    <TextView
                        android:id="@+id/shurs_det_resumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp"
                        android:textColor="@color/fc_texto_2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/shurs_det_reproducir"
                            style="@style/BotonPrimario"
                            android:layout_width="wrap_content"
                            android:paddingStart="18dp"
                            app:drawableStartCompat="@drawable/ic_reproducir"
                            android:drawablePadding="6dp"
                            app:drawableTint="@color/fc_sobre_rojo"
                            android:text="Reproducir" />

                        <TextView
                            android:id="@+id/shurs_det_guardar"
                            style="@style/BotonSecundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Guardar en mis playlists" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/shurs_det_denunciar"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:paddingEnd="12dp"
                        android:text="Denunciar esta playlist"
                        android:textSize="13.5sp"
                        android:textColor="@color/fc_texto_2"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="La música se para al salir de la app"
                        android:textSize="12.5sp"
                        android:textColor="@color/fc_texto_2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shurs_det_canciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
