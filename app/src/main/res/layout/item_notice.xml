<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de cita/mención.
     Rediseñada el 2026-09-21 a partir de la maqueta de un tester: antes eran el título del
     hilo y UNA línea de texto plano con todo lo demás mezclado (el autor salía dos veces y el
     extracto iba pegado a la frase), porque el motor entregaba el textContent entero de la
     fila de FC. Ahora cada dato viene por su lado y se pinta en su sitio.

     La MISMA fila sirve para "sus mensajes" y para la búsqueda por mensajes, que no traen
     tipo: en ese caso el bloque de arriba y el extracto se esconden y queda la fila de
     siempre (título + subtítulo). Ver NoticeAdapter.

     Fondo, márgenes y raya salen del TEMA (atributos fc*, ver EstiloApp): en Tarjetas la raíz
     es la tarjeta (sin onda: el toque es de notice_row) y NoticeAdapter recorta a su forma. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="?attr/fcFilaMargenH"
    android:layout_marginEnd="?attr/fcFilaMargenH"
    android:layout_marginTop="?attr/fcFilaMargenV"
    android:layout_marginBottom="?attr/fcFilaMargenV"
    android:background="?attr/fcFilaFondoQuieto"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/notice_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:foreground="?attr/selectableItemBackground">

        <!-- Barra de "sin leer". Se enciende y se apaga SIEMPRE junto al fondo y al punto,
             desde NoticeAdapter: media señal es peor que ninguna. -->
        <View
            android:id="@+id/notice_unread_bar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/fc_rojo"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/notice_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/notice_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/notice_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_notice"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/fc_texto_2" />

                    <TextView
                        android:id="@+id/notice_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="11sp"
                        android:textColor="@color/fc_texto_3"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <View
                        android:id="@+id/notice_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_bg"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/notice_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/fc_texto"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notice_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/fc_texto_2"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/notice_extract"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_extracto_notice"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/fc_texto_2"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/fcDivisoriaAlto"
        android:background="@color/fc_divisoria" />

</LinearLayout>
