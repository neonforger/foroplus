<?xml version="1.0" encoding="utf-8"?>
<!-- Música (pestaña tras el Popurrí, listSource = "musica"). Va incluido DENTRO del FrameLayout
     de la lista, el último para quedar encima de list_refresh: la cabecera y la tira de
     pestañas de arriba siguen siendo las del listado, así que se desliza entre pestañas igual
     que en el Popurrí o en +18. Lo enciende y lo apaga MusicaController.

     El fondo de la raíz es OPACO (fc_fondo) aunque el de la Compacta sea transparente: si una
     lista que llega tarde enciende list_empty o el aro de carga por debajo, no se trasluce. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel_musica"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_fondo"
    android:visibility="gone">

    <!-- La portada. fillViewport para que el texto de vacío quede centrado en lo que se ve. -->
    <ScrollView
        android:id="@+id/musica_portada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="?attr/fcFondoLista">

        <!-- wrap_content: con fillViewport, ScrollView lo vuelve a medir al alto de la pantalla
             si se queda corto, y entonces el peso del bloque de vacío lo centra. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="?attr/fcListaPaddingV"
            android:paddingBottom="88dp">

            <!-- Verificarse con la cuenta de FC (C2): solo con el servidor encendido en la config y
                 la cuenta activa aún sin verificar. Lo enciende MusicaController. -->
            <TextView
                android:id="@+id/musica_verificar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Vota la canción de la semana"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/fc_rojo"
                android:drawableEnd="@drawable/ic_fila"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

            <!-- La canción de la semana (C3). Solo con el servidor encendido en la config: lo
                 enciende y lo llena PanelSemana. El reproductor de la semana es OTRA instancia de
                 ReproductorMusica, en su propio hueco (oculto hasta que se toca algo): el de las
                 playlists vive en su pantalla. -->
            <LinearLayout
                android:id="@+id/musica_semana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/musica_semana_reproductor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/semana_titulo_ganadora"
                    style="@style/TituloGrupoMusica"
                    android:text="CANCIÓN DE LA SEMANA"
                    android:contentDescription="Canción de la semana"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/semana_ganadora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/semana_titulo_top"
                    style="@style/TituloGrupoMusica"
                    android:text="TOP DE ESTA SEMANA"
                    android:contentDescription="Top de esta semana"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/semana_nota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="El orden cambia con los votos. Los números se ven al cerrar la semana, el lunes."
                    android:textSize="12.5sp"
                    android:textColor="@color/fc_texto_2"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/semana_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/semana_vacia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:text="Todavía no hay canciones propuestas esta semana. Propón la primera."
                    android:textSize="14sp"
                    android:textColor="@color/fc_texto_2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/semana_pie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/fc_texto_2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/semana_proponer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Proponer una canción"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/fc_rojo"
                    android:drawableEnd="@drawable/ic_fila"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/semana_bloqueada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Esta cuenta de ForoCoches está bloqueada en Música."
                    android:textSize="14sp"
                    android:textColor="@color/fc_texto_2"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Título del grupo, con el mismo aire que las etiquetas del panel del avatar.
                 fc_texto_2 y no fc_texto_3: sobre el gris de Tarjetas el 3 no llega a 4,5:1. -->
            <TextView
                android:id="@+id/musica_tuyas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:text="TUS PLAYLISTS"
                android:contentDescription="Tus playlists"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/fc_texto_2"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/musica_playlists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Sin nada guardado: qué es esto y cómo entran las canciones. -->
            <LinearLayout
                android:id="@+id/musica_vacio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_musica"
                    app:tint="@color/fc_texto_off"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aún no tienes música"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/fc_texto" />

                <TextView
                    android:id="@+id/musica_vacio_texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Toca + y pega el enlace de una canción de YouTube o de Spotify.\n\nTambién puedes compartirla desde la app de YouTube o de Spotify y elegir «Guardar en Música»."
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/fc_texto_2" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- La pantalla de una playlist (A11): el reproductor arriba, a todo el ancho y 16:9, y la
         lista debajo con la cabecera como primera fila. El reproductor va FUERA de la lista
         para que no se desplace ni lo tape nada mientras suena (YouTube visible, gotcha del
         WebView ocluido). El hueco lo llena ReproductorMusica. -->
    <LinearLayout
        android:id="@+id/musica_playlist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/fcFondoLista"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/musica_reproductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musica_canciones"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="?attr/fcListaPaddingV"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <!-- Añadir canciones (la hoja de A10). Mismo botón que el de crear hilo en un subforo. Solo
         en la portada: en una playlist taparía el ⋮ y el asa de la última canción. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/musica_anadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Añadir canciones"
        app:backgroundTint="@color/fc_rojo"
        app:tint="@color/fc_sobre_rojo" />
</FrameLayout>
