<?xml version="1.0" encoding="utf-8"?>
<!-- La hoja "Añadir canciones" de Música (HojaAnadirMusica). Fondo y esquinas salen del tema de
     las hojas (bottomSheetDialogTheme). El contenido va en un NestedScrollView para que, con el
     teclado, la hoja siga alcanzable (mismo motivo que sheet_poll); el botón de guardar queda
     fuera del scroll, siempre a la vista. El campo de pegado NO es el contenido principal de la
     pantalla (gotcha del campo wrap_content): aquí es una caja de 2-5 líneas y está bien. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <View style="@style/Asa" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir canciones"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/fc_texto" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/anadir_texto"
                style="@style/Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pega un enlace de YouTube o Spotify, o una playlist compartida"
                android:inputType="textMultiLine|textUri"
                android:minLines="2"
                android:maxLines="5"
                android:gravity="top|start" />

            <!-- Si el portapapeles trae una canción al abrir. -->
            <TextView
                android:id="@+id/anadir_portapapeles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="Pegar lo que has copiado"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fc_rojo"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

            <TextView
                android:id="@+id/anadir_estado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13.5sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fc_texto_2"
                android:visibility="gone" />

            <!-- Una canción: la tarjeta con los dos campos editables y dónde guardarla. -->
            <LinearLayout
                android:id="@+id/anadir_una"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="14dp"
                        android:background="@drawable/bg_icono_musica"
                        android:src="@drawable/ic_musica"
                        app:tint="@color/fc_rojo"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/anadir_cancion"
                            style="@style/Campo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:hint="Canción"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />

                        <EditText
                            android:id="@+id/anadir_artista"
                            style="@style/Campo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="Artista"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="GUARDAR EN"
                    android:contentDescription="Guardar en"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/fc_texto_2" />

                <LinearLayout
                    android:id="@+id/anadir_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/anadir_nueva_fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="＋  Nueva playlist…"
                    android:textSize="15sp"
                    android:textColor="@color/fc_rojo"
                    android:background="?attr/selectableItemBackground" />

                <EditText
                    android:id="@+id/anadir_nueva"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="Nombre de la playlist nueva"
                    android:inputType="textCapSentences"
                    android:maxLength="60"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Varias: cuántas hay y cómo se llamará la playlist nueva. -->
            <LinearLayout
                android:id="@+id/anadir_varias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/anadir_varias_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/fc_texto" />

                <EditText
                    android:id="@+id/anadir_nombre_lista"
                    style="@style/Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="10dp"
                    android:hint="Nombre de la playlist nueva"
                    android:inputType="textCapSentences"
                    android:maxLength="60"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/anadir_progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/fc_texto_2" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/anadir_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/fc_rojo"
        android:visibility="gone" />

    <TextView
        android:id="@+id/anadir_guardar"
        style="@style/BotonPrimario"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:text="Guardar"
        android:visibility="gone" />
</LinearLayout>
