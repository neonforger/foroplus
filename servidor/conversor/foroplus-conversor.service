[Unit]
Description=ForoPlus: conversor de canciones de Musica a Spotify (Docker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
# FOROPLUS_API y CONVERSOR_SECRETO viven en /etc/foroplus/conversor.env (fuera del repo, 600, root).
ExecStartPre=-/usr/bin/docker rm -f foroplus-conversor
ExecStart=/usr/bin/docker run --rm --init --name foroplus-conversor --env-file /etc/foroplus/conversor.env foroplus-conversor
ExecStop=/usr/bin/docker stop foroplus-conversor
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
