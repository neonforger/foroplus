{
  "name": "foroplus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  // Cuenta de Cloudflare de ForoPlus (neonforger), nunca la personal del dueño: con otra sesión, wrangler falla.
  "account_id": "158ff03db77dee52de5ea55adb816e27",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foroplus-musica",
      "database_id": "c8a329d6-76cf-4a35-a28f-d2b0741c2c2c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 22,23 * * SUN", "30 3 * * *"] },
  "vars": { "DIAS_MIN_VOTO": "90", "LECTOR_EN_VPS": "false" },
  // Sin registros de peticiones: no guardamos nada que no haga falta.
  "observability": { "enabled": false }
}
